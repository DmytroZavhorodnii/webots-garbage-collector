              height 0.03
              radius 0.05
            }
          }
        ]
        name "left wheel"
        boundingObject USE WHEEL
        physics Physics {
          density 500
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.05 -0.08 -0.03
      }
      device [
